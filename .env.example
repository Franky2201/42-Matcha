# Domain configuration
DOMAIN_NAME=localhost
GRAPHQL_SCHEMA_URL=http://localhost:8000/graphql

# Port configurations
FRONTEND_PORT=5173
BACKEND_PORT=8000
FRONTEND_PROD_PORT=80
FRONTEND_PROD_SSL_PORT=443

# Environment mode
NODE_ENV=development
FLASK_SECRET_KEY=secretkeyflask
JWT_SECRET_KEY=secretkeyjwt

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=matcha
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/matcha

# OAuth Providers
INTRA42_CLIENT_ID=client_42
INTRA42_CLIENT_SECRET=secret_42
GOOGLE_CLIENT_ID=client_google
GOOGLE_CLIENT_SECRET=secret_google
